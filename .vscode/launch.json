{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Play K-Pop Demon Hunters (Arcade Mode)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Play K-Pop Demon Hunters (Windowed / Debug)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--windowed", "--debug"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Build Arcade Package (dist/KpopDemonHunters.pygame)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/build_arcade_package.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
